{
    "name": "mustikawijaya/pgsql-fdw",
    "description": "Laravel Postgres FDW for automated foreign table management and schema isolation",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mustika Wijaya",
            "homepage": "https://github.com/mustikawijaya"
        }
    ],
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "MustikaWijaya\\PgsqlFdw\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MustikaWijaya\\PgsqlFdw\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MustikaWijaya\\PgsqlFdw\\PgsqlFdwServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
